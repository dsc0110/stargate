/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stargate",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-12-11",
	"compatibility_flags": ["nodejs_als", "nodejs_compat"],
	"workers_dev": false,
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": ".svelte-kit/cloudflare/assets",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "STARGATE_BUCKET",
			"bucket_name": "stargate-bucket"
		}
	],
	"vars": {
		"NEWS_FEEDS": [
			{ "name": "Tagesschau", "url": "https://www.tagesschau.de/infoservices/alle-meldungen-100~rss2.xml", "category": "General" },
			{ "name": "SRF", "url": "https://www.srf.ch/news/bnf/rss/19032223", "category": "General" },
			{ "name": "BBC", "url": "https://feeds.bbci.co.uk/news/world/rss.xml", "category": "General" },
			{ "name": "Aljazeera", "url": "https://www.aljazeera.com/xml/rss/all.xml", "category": "General" },
			{ "name": "Hacker News", "url": "https://hnrss.org/frontpage", "category": "Tech" },
			{ "name": "TechCrunch", "url": "https://techcrunch.com/feed/", "category": "Tech" },
			{ "name": "Cloudflare", "url": "https://developers.cloudflare.com/changelog/rss/index.xml", "category": "Tech" },
			{ "name": "Science", "url": "https://science.sciencemag.org/rss/current.xml", "category": "Magazine" },
			{ "name": "Telepolis", "url": "https://www.telepolis.de/feed.xml", "category": "Magazine" },
			{ "name": "Kino", "url": "https://www.kino.de/feed/film/", "category": "Magazine" },
			{ "name": "Postillon", "url": "https://feeds.feedburner.com/blogspot/rkEL", "category": "Fun" },
			{ "name": "Titanic", "url": "https://www.titanic-magazin.de/ich.war.bei.der.waffen.rss", "category": "Fun" },
			{ "name": "Twitterperlen", "url": "https://www.twitterperlen.de/feed", "category": "Fun" },
			{ "name": "Transfermarkt", "url": "https://www.transfermarkt.de/rss/news", "category": "Sport" },
			{ "name": "Sportschau", "url": "https://www.sportschau.de/fussball/index~rss2.xml", "category": "Sport" }
		],
		"JOURNALS_FEEDS": [
			{ "name": "Init 7", "url": "https://blog.init7.net/en/feed/" },
			{ "name": "Astral Codex Ten", "url": "https://astralcodexten.substack.com/feed" },
			{ "name": "Wait But Why", "url": "https://waitbutwhy.com/feed" }
		],
		"BODY_SIZE_CM": 181
	}
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	// "vars": { "MY_VARIABLE": "production_value" }
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
